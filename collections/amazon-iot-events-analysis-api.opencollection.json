{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS IoT Events Alarm Models Analysis API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Analysis",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon IoT Events Describe Detector Model Analysis",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://iotevents.{region}.amazonaws.com/analysis/detector-models/:analysisId",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "analysisId",
                "value": "",
                "type": "path",
                "description": "The ID of the analysis result that you want to retrieve."
              }
            ]
          },
          "docs": "<p>Retrieves runtime information about a detector model analysis.</p> <note> <p>After AWS IoT Events starts analyzing your detector model, you have up to 24 hours to retrieve the analysis results.</p> </note>"
        },
        {
          "info": {
            "name": "Amazon IoT Events Get Detector Model Analysis Results",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://iotevents.{region}.amazonaws.com/analysis/detector-models/:analysisId/results",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "analysisId",
                "value": "",
                "type": "path",
                "description": "The ID of the analysis result that you want to retrieve."
              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query",
                "description": "The token that you can use to return the next set of results."
              },
              {
                "name": "maxResults",
                "value": "",
                "type": "query",
                "description": "The maximum number of results to be returned per request."
              }
            ]
          },
          "docs": "<p>Retrieves one or more analysis results of the detector model.</p> <note> <p>After AWS IoT Events starts analyzing your detector model, you have up to 24 hours to retrieve the analysis results.</p> </note>"
        },
        {
          "info": {
            "name": "Amazon IoT Events Start Detector Model Analysis",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://iotevents.{region}.amazonaws.com/analysis/detector-models/",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Performs an analysis of your detector model. For more information, see <a href=\"https://docs.aws.amazon.com/iotevents/latest/developerguide/iotevents-analyze-api.html\">Troubleshooting a detector model</a> in the <i>AWS IoT Events Developer Guide</i>."
        }
      ]
    }
  ],
  "bundled": true
}